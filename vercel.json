{
  "functions": {
    "api/*.js": {
      "includeFiles": "api/*.pem",
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "regions": [
    "cdg1"
  ]
}